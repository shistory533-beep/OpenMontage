{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "prompt": "{file:.opencode/prompts/build-autoplan.md}",
      "model": "omniroute/auto"
    }
  },
  "provider": {
    "free-auto": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FREE-AUTO",
      "options": {
        "baseURL": "http://127.0.0.1:4100/v1"
      },
      "models": {
        "free-auto": {
          "name": "FREE-AUTO"
        }
      }
    },
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "{env:OMNIROUTE_API_KEY}"
      },
      "models": {
        "omniroute/auto": {
          "name": "omniroute/auto"
        }
      }
    },
    "bytez": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bytez",
      "options": {
        "baseURL": "https://api.bytez.com/models/v2/openai/v1",
        "apiKey": "{env:BYTEZ_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3-4B": {
          "name": "Qwen3 4B (Bytez)"
        },
        "google/gemma-3-4b-it": {
          "name": "Gemma 3 4B IT (Bytez)"
        }
      }
    }
  }
}
