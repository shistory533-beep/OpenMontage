{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/package_bundle",
  "title": "Package Bundle",
  "description": "Upload-ready metadata bundle: scored titles, description, chapters, tags, subtitles, thumbnail spec. No publish action.",
  "type": "object",
  "required": ["version", "titles", "chosen_title", "description", "chapters", "tags", "subtitles", "thumbnail"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "episode_id": { "type": "string" },
    "titles": {
      "type": "object",
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["title", "scores", "final_score", "misleading_risk", "accepted"],
            "properties": {
              "title": { "type": "string" },
              "scores": { "type": "object" },
              "final_score": { "type": "number" },
              "misleading_risk": { "type": "number" },
              "accepted": { "type": "boolean", "const": true }
            }
          }
        },
        "rejected": { "type": "array", "items": { "type": "string" } }
      }
    },
    "chosen_title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "chapters": { "type": "array" },
    "tags": { "type": "object" },
    "subtitles": { "type": "object" },
    "thumbnail": {
      "type": "object",
      "required": ["focal_subject", "composition", "text", "contrast", "visual_concept", "reason"],
      "properties": {
        "focal_subject": { "type": "string" },
        "composition": { "type": "string" },
        "text": { "type": "string" },
        "text_word_count": { "type": "number" },
        "contrast": { "type": "string" },
        "visual_concept": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "video_path": { "type": "string" }
  },
  "additionalProperties": true
}
