{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/storyboard",
  "title": "Documentary Storyboard",
  "description": "Visual requirements derived from approved narration: one or more requirements per narration block, chapter plan, and coverage. Availability is uncertain/missing only — the board never assumes footage exists.",
  "type": "object",
  "required": ["version", "title", "requirements", "chapter_plan", "coverage"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "script_title": { "type": "string" },
    "factcheck_passed": { "type": "boolean" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "narration_block_id", "visual_objective", "subject", "preferred_media_type", "shot_function", "minimum_duration_seconds", "desired_duration_seconds", "positive_search_terms", "rights_requirement", "priority", "fallback_policy", "availability"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "narration_block_id": { "type": "string", "minLength": 1 },
          "visual_objective": { "type": "string" },
          "subject": { "type": "string" },
          "location": { "type": "string" },
          "period": { "type": "string" },
          "preferred_media_type": { "type": "string", "enum": ["video", "image", "any"] },
          "shot_type": { "type": "string" },
          "shot_function": { "type": "string" },
          "minimum_duration_seconds": { "type": "number", "minimum": 0 },
          "desired_duration_seconds": { "type": "number", "minimum": 0 },
          "evidence_relationship": { "type": "string" },
          "claim_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_source_ids": { "type": "array", "items": { "type": "string" } },
          "positive_search_terms": { "type": "array", "items": { "type": "string" } },
          "exclusion_terms": { "type": "array", "items": { "type": "string" } },
          "rights_requirement": { "type": "string" },
          "priority": { "type": "string" },
          "fallback_policy": { "type": "string" },
          "availability": { "type": "string", "enum": ["available", "uncertain", "missing"] },
          "scoring": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "chapter_plan": { "type": "array" },
    "coverage": { "type": "object" },
    "scoring_summary": { "type": "object" }
  },
  "additionalProperties": true
}
