{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/factcheck_report",
  "title": "Fact-Check Report",
  "description": "Independent per-claim verdicts for a documentary script. Blocking claims (contradicted, or critical unsupported/unresearched) must be resolved before storyboard. Verdicts never rewrite claims.",
  "type": "object",
  "required": ["version", "package_hash", "verdicts", "blocking_claim_ids", "passed"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "script_title": { "type": "string" },
    "package_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "verdict", "source_ids", "evidence_summary", "confidence", "recommendation", "blocks_approval"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string" },
          "verdict": { "type": "string", "enum": ["verified", "partially_verified", "contradicted", "unsupported", "opinion", "requires_research"] },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_summary": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "problem": { "type": "string" },
          "recommendation": { "type": "string", "enum": ["cut", "re-source", "hedge", "research", "none"] },
          "blocks_approval": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "blocking_claim_ids": { "type": "array", "items": { "type": "string" } },
    "passed": { "type": "boolean" },
    "checked_at": { "type": "string" }
  },
  "additionalProperties": true
}
