{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/footage_report",
  "title": "Footage Report",
  "description": "Per-asset footage intelligence verdicts (pass/weak/wrong/missing) over the acquired asset_manifest.",
  "type": "object",
  "required": ["version", "verdicts"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "verdict"],
        "properties": {
          "asset_id": { "type": "string", "minLength": 1 },
          "requirement_id": { "type": ["string", "null"] },
          "verdict": { "type": "string", "enum": ["pass", "weak", "wrong", "missing"] },
          "score": { "type": "number" },
          "rights": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
