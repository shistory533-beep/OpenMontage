{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/evidence_bundle",
  "title": "Evidence Bundle",
  "description": "Consolidated research output for the evidence stage: sourced facts, claims, evidence graph, contradictions, and open questions, pinned by a deterministic package hash.",
  "type": "object",
  "required": ["version", "topic", "sources", "facts", "claims", "evidence_graph", "contradictions", "open_questions", "package_hash"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "topic": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "language": { "type": "string" },
    "target_duration_seconds": { "type": "number", "minimum": 0 },
    "channel_niche": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "url", "publisher", "source_type", "retrieved_at"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "date": { "type": "string" },
          "source_type": { "type": "string" },
          "retrieved_at": { "type": "string" },
          "credibility": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "statement_type", "source_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "statement_type": { "type": "string", "enum": ["fact", "inference", "opinion", "unresolved"] },
          "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "subject_key": { "type": "string" },
          "numeric_value": { "type": ["number", "null"] },
          "numeric_unit": { "type": "string" },
          "date_value": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "claim_type": { "type": "string", "enum": ["factual", "opinion"] },
          "fact_ids": { "type": "array", "items": { "type": "string" } },
          "source_ids": { "type": "array", "items": { "type": "string" } },
          "critical": { "type": "boolean" },
          "is_direct_quote": { "type": "boolean" },
          "attribution": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "evidence_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": { "type": "object" },
        "edges": { "type": "array" }
      },
      "additionalProperties": true
    },
    "contradictions": { "type": "array" },
    "open_questions": { "type": "array" },
    "package_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string" }
  },
  "additionalProperties": true
}
